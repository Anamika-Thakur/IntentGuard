# IntentGuard Environment Configuration Example
# Copy this file to .env for local configuration

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# PostgreSQL Database Connection
# In local development without Postgres, leave DATABASE_URL empty or set USE_IN_MEMORY_DB=true
DATABASE_URL=postgresql://intentguard_user:intentguard_password@localhost:5432/intentguard_db
USE_IN_MEMORY_DB=false

# Cryptographic Authorization Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_HMAC_SECRET_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_ACTIVE_KEY_ID=v1

# PayPal Sandbox Credentials (NEVER use production credentials)
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=placeholder_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=placeholder_paypal_sandbox_client_secret

# AI Agent Boundary
AI_AGENT_MAX_PROPOSAL_CENTS=50000
